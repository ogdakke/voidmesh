{
  "name": "@voidmesh/web",
  "private": true,
  "type": "module",
  "imports": {
    "#ui/*": "./components/ui/*",
    "#components/*": "./components/*",
    "#engine": "./engine/index.ts",
    "#application/*": "./application/*",
    "#renderer/*": "./renderer/*",
    "#wlur": "@voidmesh/wlur",
    "#wlur/*": "@voidmesh/wlur/*",
    "#types/*": "./types/*",
    "#lib/*": "./lib/*",
    "#hooks/*": "./hooks/*",
    "#context/*": "./context/*",
    "#config": "./lib/config/index.ts",
    "#media/*": "./media/*",
    "#styles/*": "./styles/*"
  },
  "scripts": {
    "dev": "vite dev",
    "bench:render": "vite dev --host 127.0.0.1 --port 5175",
    "bench:render:record": "bun run scripts/render-bench-record.ts",
    "bench:render:compare": "bun run scripts/render-bench-compare.ts",
    "bench:render:ab": "bun run scripts/render-bench-ab.ts",
    "build": "vite build",
    "sourcemap": "posthog-cli sourcemap inject -d ./dist/assets && posthog-cli sourcemap upload -d ./dist/assets --release-name voidmesh --delete-after",
    "preview": "vite preview",
    "test": "bun run --bun vitest run",
    "test:watch": "bun run --bun vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "media:sync": "bun run scripts/media-sync.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@base-ui/utils": "^0.3.1",
    "@noble/hashes": "^2.2.0",
    "@posthog/react": "^1.10.3",
    "@vercel/blob": "^2.6.1",
    "@voidmesh/api-contract": "workspace:*",
    "@voidmesh/collaboration": "workspace:*",
    "@voidmesh/domain": "workspace:*",
    "@voidmesh/wlur": "workspace:*",
    "better-auth": "^1.6.23",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "iconoir-react": "^7.11.1",
    "mediabunny": "^1.50.8",
    "miniray": "^0.3.1",
    "nuqs": "^2.9.0",
    "posthog-js": "^1.400.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.12.2",
    "thumbhash": "^0.1.1",
    "unstorage": "^1.17.5",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@posthog/cli": "^0.8.2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/wicg-file-system-access": "2023.10.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@webgpu/types": "^0.1.71",
    "agentation": "^3.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.10.6",
    "sharp": "^0.35.3",
    "type-fest": "^5.8.0",
    "vite": "8.1.4",
    "vite-plugin-pwa": "1.3.0",
    "workbox-window": "7.4.1"
  }
}
