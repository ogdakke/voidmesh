{
  "name": "voidmesh",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --workspaces --parallel --if-present dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api dev",
    "build": "bun run --workspaces --sequential --if-present build",
    "build:web": "bun run --cwd apps/web build",
    "build:api": "bun run --cwd apps/api build",
    "test": "bun run --workspaces --sequential --if-present test",
    "test:watch": "bun run --cwd apps/web test:watch",
    "lint:all": "oxlint . --type-aware --type-check && bun run lint:typecheck",
    "lint": "oxlint . --type-aware --",
    "lint:fix": "oxlint . --type-aware --fix",
    "lint:typecheck": "bun run --workspaces --sequential --if-present typecheck",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "bench:render": "bun run --cwd apps/web bench:render",
    "bench:render:record": "bun run --cwd apps/web bench:render:record",
    "bench:render:compare": "bun run --cwd apps/web bench:render:compare",
    "bench:render:ab": "bun run --cwd apps/web bench:render:ab",
    "install:hooks": "sh scripts/install-hooks.sh",
    "media:sync": "bun run --cwd apps/web media:sync"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.24.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "@posthog/cli",
    "core-js",
    "workerd"
  ]
}
