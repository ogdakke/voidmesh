{
  "name": "voidmesh",
  "private": true,
  "type": "module",
  "imports": {
    "#ui/*": "./components/ui/*",
    "#components/*": "./components/*",
    "#engine": "./engine/index.ts",
    "#renderer/*": "./renderer/*",
    "#types/*": "./types/*",
    "#lib/*": "./lib/*",
    "#hooks/*": "./hooks/*",
    "#context/*": "./context/*",
    "#config": "./lib/config/index.ts",
    "#media/*": "./media/*",
    "#styles/*": "./styles/*",
    "#weights/*": "./weights/*"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:https": "HTTPS=1 vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun run --bun vitest run",
    "lint:all": "oxlint . --type-aware --type-check",
    "lint": "oxlint . --type-aware --",
    "lint:fix": "oxlint . --type-aware --fix",
    "lint:typecheck": "tsgo --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "install:hooks": "sh scripts/install-hooks.sh",
    "media:sync": "bun run scripts/media-sync.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.3.0",
    "@base-ui/utils": "^0.2.6",
    "@posthog/react": "^1.8.2",
    "@vercel/blob": "^2.3.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "gifenc": "^1.0.3",
    "iconoir-react": "^7.11.0",
    "mediabunny": "^1.39.2",
    "miniray": "^0.3.1",
    "nuqs": "^2.8.9",
    "posthog-js": "^1.360.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^4.7.3",
    "thumbhash": "^0.1.1",
    "unstorage": "^1.17.4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.8.4",
    "@rolldown/plugin-babel": "^0.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260315.1",
    "@vitejs/plugin-basic-ssl": "^2.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@webgpu/types": "^0.1.69",
    "agentation": "^2.3.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.8.4",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "oxlint-tsgolint": "^0.16.0",
    "sharp": "^0.34.5",
    "type-fest": "^5.4.4",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "packageManager": "bun@1.3.10"
}
