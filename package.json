{
  "name": "voidmesh",
  "private": true,
  "type": "module",
  "imports": {
    "#ui/*": "./components/ui/*",
    "#components/*": "./components/*",
    "#engine": "./engine/index.ts",
    "#application/*": "./application/*",
    "#renderer/*": "./renderer/*",
    "#wlur": "./packages/wlur/index.ts",
    "#wlur/*": "./packages/wlur/*",
    "#types/*": "./types/*",
    "#lib/*": "./lib/*",
    "#hooks/*": "./hooks/*",
    "#context/*": "./context/*",
    "#config": "./lib/config/index.ts",
    "#media/*": "./media/*",
    "#styles/*": "./styles/*"
  },
  "scripts": {
    "dev": "vite dev",
    "bench:render": "vite dev --host 127.0.0.1 --port 5175",
    "bench:render:record": "bun run scripts/render-bench-record.ts",
    "bench:render:compare": "bun run scripts/render-bench-compare.ts",
    "bench:render:ab": "bun run scripts/render-bench-ab.ts",
    "build": "vite build",
    "sourcemap": "posthog-cli sourcemap inject -d ./dist/assets && posthog-cli sourcemap upload -d ./dist/assets --release-name voidmesh --delete-after",
    "preview": "vite preview",
    "test": "bun run --bun vitest run",
    "test:watch": "bun run --bun vitest",
    "lint:all": "oxlint . --type-aware --type-check",
    "lint": "oxlint . --type-aware --",
    "lint:fix": "oxlint . --type-aware --fix",
    "lint:typecheck": "tsc --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "install:hooks": "sh scripts/install-hooks.sh",
    "media:sync": "bun run scripts/media-sync.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@base-ui/utils": "^0.5.0",
    "@posthog/react": "^1.11.3",
    "@vercel/blob": "^2.8.2",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "iconoir-react": "^7.12.1",
    "mediabunny": "^1.61.6",
    "miniray": "^0.3.1",
    "nuqs": "^2.10.2",
    "posthog-js": "^1.438.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.5",
    "thumbhash": "^0.1.1",
    "unstorage": "^1.17.6"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.3",
    "@posthog/cli": "^0.18.10",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wicg-file-system-access": "2023.10.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "agentation": "^3.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "sharp": "^0.35.5",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "7.4.1"
  },
  "packageManager": "bun@1.4.3",
  "trustedDependencies": [
    "@posthog/cli",
    "core-js"
  ]
}
