{
  "name": "voidmesh",
  "private": true,
  "type": "module",
  "imports": {
    "#ui/*": "./components/ui/*",
    "#components/*": "./components/*",
    "#engine": "./engine/index.ts",
    "#renderer/*": "./renderer/*",
    "#types/*": "./types/*",
    "#lib/*": "./lib/*",
    "#hooks/*": "./hooks/*",
    "#context/*": "./context/*",
    "#config": "./lib/config/index.ts",
    "#media/*": "./media/*",
    "#styles/*": "./styles/*",
    "#weights/*": "./weights/*"
  },
  "scripts": {
    "dev": "vp dev",
    "dev:https": "HTTPS=1 vp dev --host",
    "build": "vp build",
    "preview": "vp preview",
    "test": "bun run --bun vitest run",
    "lint:all": "vp lint . --type-aware --type-check",
    "lint": "vp lint . --type-aware --",
    "lint:fix": "vp lint . --type-aware --fix",
    "lint:typecheck": "tsgo --noEmit",
    "format": "vp fmt .",
    "format:check": "vp fmt . --check",
    "install:hooks": "sh scripts/install-hooks.sh",
    "media:sync": "bun run scripts/media-sync.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@base-ui/utils": "^0.2.5",
    "@posthog/react": "^1.8.1",
    "@vercel/blob": "^2.3.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "gifenc": "^1.0.3",
    "iconoir-react": "^7.11.0",
    "mediabunny": "^1.35.1",
    "miniray": "^0.3.1",
    "nuqs": "^2.8.9",
    "posthog-js": "^1.356.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^4.6.5",
    "thumbhash": "^0.1.1",
    "unstorage": "^1.17.4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.7.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260228.1",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-react": "^5.1.4",
    "@webgpu/types": "^0.1.69",
    "agentation": "^2.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.7.0",
    "sharp": "^0.34.5",
    "type-fest": "^5.4.4",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "0.1.11",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    },
    "onlyBuiltDependencies": [
      "core-js",
      "protobufjs",
      "sharp"
    ]
  }
}
