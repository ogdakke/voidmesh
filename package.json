{
  "name": "voidmesh",
  "private": true,
  "type": "module",
  "imports": {
    "#ui/*": "./components/ui/*",
    "#components/*": "./components/*",
    "#engine": "./engine/index.ts",
    "#renderer/*": "./renderer/*",
    "#wlur": "./packages/wlur/index.ts",
    "#wlur/*": "./packages/wlur/*",
    "#types/*": "./types/*",
    "#lib/*": "./lib/*",
    "#hooks/*": "./hooks/*",
    "#context/*": "./context/*",
    "#config": "./lib/config/index.ts",
    "#media/*": "./media/*",
    "#styles/*": "./styles/*",
    "#weights/*": "./weights/*"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:https": "HTTPS=1 vite dev --host",
    "build": "vite build",
    "sourcemap": "posthog-cli sourcemap inject -d ./dist/assets && posthog-cli sourcemap upload -d ./dist/assets --release-name voidmesh --delete-after",
    "preview": "vite preview",
    "test": "bun run --bun vitest run",
    "test:watch": "bun run --bun vitest",
    "lint:all": "oxlint . --type-aware --type-check",
    "lint": "oxlint . --type-aware --",
    "lint:fix": "oxlint . --type-aware --fix",
    "lint:typecheck": "tsgo --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "install:hooks": "sh scripts/install-hooks.sh",
    "media:sync": "bun run scripts/media-sync.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@base-ui/utils": "^0.2.8",
    "@posthog/react": "^1.9.0",
    "@vercel/blob": "^2.3.3",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "gifenc": "^1.0.3",
    "iconoir-react": "^7.11.0",
    "mediabunny": "^1.44.1",
    "miniray": "^0.3.1",
    "nuqs": "^2.8.9",
    "posthog-js": "^1.372.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-resizable-panels": "^4.11.0",
    "thumbhash": "^0.1.1",
    "unstorage": "^1.17.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@posthog/cli": "^0.7.11",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/wicg-file-system-access": "2023.10.7",
    "@typescript/native-preview": "^7.0.0-dev.20260507.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@webgpu/types": "^0.1.69",
    "agentation": "^3.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.9.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1",
    "sharp": "^0.34.5",
    "type-fest": "^5.6.0",
    "vite": "^8.0.11",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^4.1.5",
    "workbox-window": "7.4.1"
  },
  "packageManager": "bun@1.3.12"
}
